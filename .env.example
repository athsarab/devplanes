# PostgreSQL
DATABASE_URL="postgresql://devscope:devscope@localhost:5432/devscope"

# API
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Frontend public configuration only
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# GitHub App - server only
GITHUB_APP_ID="replace-with-development-app-id"
GITHUB_APP_CLIENT_ID="replace-with-development-client-id"
GITHUB_APP_CLIENT_SECRET="replace-with-development-client-secret"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\\nreplace-me\\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALL_URL="https://github.com/apps/devscope-dev/installations/new"
GITHUB_APP_SETUP_URL="http://localhost:3001/api/v1/github/install/callback"
GITHUB_APP_WEB_CALLBACK_URL="http://localhost:3000/dashboard/repositories?github=connected"
GITHUB_APP_WEBHOOK_SECRET="replace-with-random-webhook-secret"

# Billing - server only
STRIPE_SECRET_KEY="replace-with-server-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-secret"
STRIPE_PRO_PRICE_ID="replace-with-pro-price-id"
STRIPE_TEAM_PRICE_ID="replace-with-team-price-id"
STRIPE_SUCCESS_URL="http://localhost:3000/dashboard/settings/billing?checkout=processing"
STRIPE_CANCEL_URL="http://localhost:3000/dashboard/settings/billing?checkout=canceled"
STRIPE_PORTAL_RETURN_URL="http://localhost:3000/dashboard/settings/billing"

# Local demo authentication - never enable outside trusted local/demo environments
DEVSCAPE_DEMO_AUTH="true"
DEVSCAPE_DEMO_EMAIL="demo@devscope.local"
DEVSCAPE_DEMO_WORKSPACE="devscope-demo"

# AI insights - server only
AI_ENABLED="false"
AI_API_KEY=""
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_MODEL="gpt-4.1-mini"
